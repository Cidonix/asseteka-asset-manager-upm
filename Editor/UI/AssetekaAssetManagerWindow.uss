.asseteka-brand {
    width: 127px;
    height: 32px;
    align-self: flex-start;
    flex-shrink: 0;
}

.asseteka-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.asseteka-header-brand {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 180px;
    margin-right: 16px;
}

.asseteka-header-subtitle {
    margin-top: 4px;
    font-size: 13px;
    white-space: normal;
    opacity: 0.8;
}

.asseteka-account {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    max-width: 360px;
}

.asseteka-account-identity {
    flex-shrink: 1;
    min-width: 72px;
    max-width: 200px;
    margin-left: 10px;
    margin-right: 10px;
}

.asseteka-account-name,
.asseteka-account-email {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
}

.asseteka-account-name {
    font-size: 14px;
    -unity-font-style: bold;
}

.asseteka-account-email {
    margin-top: 3px;
    font-size: 12px;
    opacity: 0.75;
}

.asseteka-account-sign-out {
    flex-shrink: 0;
}

.asseteka-action-button {
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    margin: 0;
    padding: 0 4px;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.asseteka-account > .asseteka-action-button {
    margin-left: 8px;
}

.asseteka-connection-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 4px 8px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.2);
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0.06);
}

.asseteka-control-label {
    flex-shrink: 0;
    height: 24px;
    margin: 0 10px 0 0;
    font-size: 13px;
    -unity-text-align: middle-left;
}

.asseteka-control {
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0;
    font-size: 14px;
}

.asseteka-control > .unity-base-field__label {
    display: none;
}

.asseteka-control > .unity-base-field__input {
    min-height: 24px;
    height: 24px;
    padding: 0 4px;
}

.asseteka-control .unity-base-popup-field__text {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.asseteka-connection-server {
    width: 180px;
    flex-shrink: 0;
}

.asseteka-control-spacer {
    flex-grow: 1;
    min-width: 12px;
}

.asseteka-feedback {
    position: relative;
    flex-shrink: 0;
    min-height: 32px;
    margin-bottom: 8px;
}

.asseteka-status {
    min-height: 32px;
    margin: 0;
    white-space: normal;
    font-size: 12px;
    -unity-text-align: middle-left;
    opacity: 0.8;
}

.asseteka-activity {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 32px;
    flex-direction: row;
    align-items: center;
    visibility: hidden;
}

.asseteka-progress {
    flex-grow: 1;
    min-width: 0;
    height: 24px;
    margin-right: 8px;
}

.asseteka-image-preview {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    background-color: rgba(128, 128, 128, 0.15);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.25);
    border-radius: 4px;
}

.asseteka-preview-image {
    display: none;
    width: 100%;
    height: 100%;
}

.asseteka-preview-fallback {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    -unity-text-align: middle-center;
    font-size: 12px;
    opacity: 0.75;
}

.asseteka-account-avatar {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(255, 157, 85, 0.2);
    border-color: rgba(255, 157, 85, 0.45);
}

.asseteka-account-avatar > .asseteka-preview-fallback {
    font-size: 16px;
    -unity-font-style: bold;
    opacity: 1;
}

.asseteka-library-card {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 60px;
    min-height: 60px;
    max-height: 60px;
    padding: 0;
    margin: 0 0 2px 0;
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(128, 128, 128, 0.04);
    overflow: hidden;
}

.asseteka-library-card:hover {
    background-color: rgba(128, 128, 128, 0.15);
}

.asseteka-library-card--selected {
    border-left-color: rgb(255, 157, 85);
    background-color: rgba(255, 157, 85, 0.18);
}

.asseteka-library-card--selected:hover {
    background-color: rgba(255, 157, 85, 0.24);
}

.asseteka-library-preview {
    width: 80px;
    height: 60px;
    margin-right: 10px;
}

.asseteka-library-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 8px;
}

.asseteka-library-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.asseteka-library-version {
    margin: 5px 0 0 0;
    font-size: 12px;
    opacity: 0.75;
    -unity-text-align: middle-left;
}

.asseteka-library-controls {
    flex-shrink: 0;
    margin-bottom: 12px;
}

.asseteka-search-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.asseteka-library-search {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.asseteka-library-options {
    flex-direction: row;
    align-items: center;
}

.asseteka-control-group {
    flex-direction: row;
    align-items: center;
    margin-right: 24px;
}

.asseteka-library-sort {
    width: 200px;
    flex-shrink: 0;
}

.asseteka-library-count {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    font-size: 12px;
    white-space: normal;
}

.asseteka-library-columns {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
}

.asseteka-library-pane {
    flex-grow: 43;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 260px;
    min-height: 0;
    margin-right: 12px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.25);
    border-radius: 4px;
    overflow: hidden;
}

.asseteka-pane-heading {
    flex-shrink: 0;
    margin: 0;
    padding: 8px 12px;
    font-size: 14px;
    -unity-font-style: bold;
}

.asseteka-library-list {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
}

.asseteka-library-list-content {
    flex-grow: 0;
    min-width: 0;
}

.asseteka-details-pane {
    flex-grow: 57;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.25);
    border-radius: 4px;
}

.asseteka-library-details {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}

.asseteka-project-recovery-link {
    flex-shrink: 0;
    align-self: flex-end;
    margin: 8px 14px 0 14px;
}

.asseteka-details-content {
    flex-grow: 1;
    padding: 14px;
}

.asseteka-window--dark .asseteka-library-pane,
.asseteka-window--dark .asseteka-details-pane {
    background-color: rgba(0, 0, 0, 0.08);
}

.asseteka-window--light .asseteka-library-pane,
.asseteka-window--light .asseteka-details-pane {
    background-color: rgba(255, 255, 255, 0.16);
}

.asseteka-library-list > .unity-scroll-view__content-and-vertical-scroll-container,
.asseteka-library-details > .unity-scroll-view__content-and-vertical-scroll-container {
    min-height: 0;
}

.asseteka-library-pager {
    flex-shrink: 0;
    padding: 8px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.2);
}

.asseteka-library-load-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
}

.asseteka-library-load-more {
    flex-shrink: 0;
    margin-left: 8px;
}

.asseteka-library-sync-footer {
    height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.asseteka-library-last-refresh {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 8px 0 0;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.75;
}

.asseteka-library-refresh {
    height: 28px;
    width: 28px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
}

.asseteka-library-refresh-icon {
    height: 20px;
    width: 20px;
    flex-shrink: 0;
}

.asseteka-library-refresh-error {
    color: rgb(221, 139, 56);
    opacity: 1;
}

.asseteka-window--light .asseteka-library-refresh-error {
    color: rgb(145, 78, 0);
}

.asseteka-window--compact .asseteka-header {
    margin-bottom: 6px;
}

.asseteka-window--compact .asseteka-connection-toolbar {
    margin-bottom: 6px;
}

.asseteka-window--compact .asseteka-feedback {
    margin-bottom: 4px;
}

.asseteka-details-title {
    white-space: normal;
    margin: 0 0 6px 0;
    font-size: 20px;
    -unity-font-style: bold;
}

.asseteka-delivery-card {
    margin-top: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.2);
}

.asseteka-delivery-card > .asseteka-action-button {
    margin-top: 8px;
    align-self: flex-start;
}

.asseteka-detail-actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.asseteka-detail-actions > .asseteka-action-button {
    height: auto;
    max-width: 100%;
    margin: 6px 8px 0 0;
    padding: 3px 6px;
    white-space: normal;
}

.asseteka-detail-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 14px;
    padding: 4px;
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0.12);
}

.asseteka-detail-tab {
    height: 28px;
    padding: 0 10px;
    margin-right: 4px;
}

.asseteka-detail-tab.asseteka-detail-tab--active {
    background-color: rgba(221, 139, 56, 0.22);
    border-color: rgba(221, 139, 56, 0.8);
    -unity-font-style: bold;
}

.asseteka-detail-tab-content {
    margin-top: 8px;
}

.asseteka-detail-release {
    margin-bottom: 12px;
    padding: 8px;
    border-left-width: 2px;
    border-left-color: rgba(221, 139, 56, 0.64);
}

.asseteka-detail-release-title {
    font-size: 14px;
    white-space: normal;
    -unity-font-style: bold;
}

.asseteka-gallery-image {
    height: 220px;
    margin-bottom: 8px;
}

.asseteka-detail-website-link {
    align-self: flex-start;
    margin-top: 8px;
}

.asseteka-empty-panel {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 20px;
}

.asseteka-empty-title {
    margin: 0 0 10px 0;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.asseteka-empty-message {
    margin: 0;
    max-width: 340px;
    font-size: 13px;
    opacity: 0.75;
    -unity-text-align: middle-center;
    white-space: normal;
}

.asseteka-alpha-options {
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 8px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.3);
    border-radius: 4px;
    font-size: 13px;
}

.asseteka-alpha-options .unity-base-field {
    margin-bottom: 6px;
}

.asseteka-alpha-options .unity-help-box__text {
    font-size: 12px;
    white-space: normal;
}
.asseteka-window {
    flex-grow: 1;
    min-height: 0;
    padding: 12px 16px;
    font-size: 14px;
}
